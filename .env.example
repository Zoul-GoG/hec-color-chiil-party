# Les 4 seules variables d'environnement de l'application (voir docs/08-DEPLOYMENT.md §1).
# En local, MONGODB_URI peut être laissée vide : l'API démarre alors sur mongodb-memory-server (données non persistées).
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxx.mongodb.net/hec_color_chill
ADMIN_EMAIL=bde@hec.ci
ADMIN_PASSWORD=un-mot-de-passe-long
JWT_SECRET=une-longue-chaine-aleatoire-d-au-moins-32-caracteres
